{
  "name": "harness-architecture-book-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build:astro": "astro build",
    "check": "astro check",
    "validate": "bun run src/scripts/validate-corpus.ts",
    "index": "bun run src/scripts/generate-local-indexes.ts && pagefind --site dist",
    "build": "bun run validate && bun run build:astro && bun run index",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "astro": "^6.3.2",
    "katex": "^0.16.46",
    "pagefind": "^1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
